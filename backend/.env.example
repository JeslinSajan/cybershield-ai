# CyberShield AI Backend Environment Variables
# Copy this file to .env and fill in your actual values
# .env is excluded from git by .gitignore

# =============================================================================
# DATABASE
# =============================================================================

# Neon PostgreSQL Database Connection String
# Get this from your Neon dashboard: https://console.neon.tech
#
# IMPORTANT: This project uses psycopg (v3), NOT psycopg2.
# SQLAlchemy needs "postgresql+psycopg://" to use the v3 driver.
# The code in app/core/database.py auto-normalizes "postgresql://" → "postgresql+psycopg://",
# so both forms work. Prefer the explicit form below to avoid confusion.
#
# Explicit form (preferred):
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# Plain form (also works — code normalizes it automatically):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Local development (SQLite — does not require a running Postgres):
# DATABASE_URL=sqlite:///./cybershield_dev.db

# =============================================================================
# APPLICATION
# =============================================================================

ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# =============================================================================
# SECURITY — JWT (Phase 8)
# =============================================================================

# JWT_SECRET_KEY MUST be changed in production.
# Generate a strong key: openssl rand -hex 32
# The app will log a SECURITY WARNING on startup if this default value is used in production.
# NEVER commit a real secret key to version control.
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# SEEDING — Initial admin user (Phase 8)
# =============================================================================

# Set these environment variables in Render (or locally) to auto-create the
# first Administrator account on application startup. Seeding is idempotent —
# it will not re-create the user if it already exists.
#
# SECURITY: These values are NEVER logged by the application, even at DEBUG level.
# Do not put actual credentials in this file — set them as secrets in Render.
#
# SEED_ADMIN_EMAIL=admin@your-domain.com
# SEED_ADMIN_PASSWORD=ChangeThisToAStrongPassword!

# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed origins (leave unset in development to allow all)
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://cybershield-ai.vercel.app
