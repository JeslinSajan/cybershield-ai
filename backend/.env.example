# CyberShield AI Backend Environment Variables
# Copy this file to .env and fill in your actual values
# .env is excluded from git by .gitignore

# Neon PostgreSQL Database Connection String
# Get this from your Neon dashboard: https://console.neon.tech
#
# IMPORTANT: This project uses psycopg (v3), NOT psycopg2.
# SQLAlchemy needs "postgresql+psycopg://" to use the v3 driver.
# The code in app/core/database.py auto-normalizes "postgresql://" → "postgresql+psycopg://",
# so both forms work. Prefer the explicit form below to avoid confusion.
#
# Explicit form (preferred):
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# Plain form (also works — code normalizes it automatically):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Security Configuration (for Phase 8 - Authentication)
# JWT_SECRET_KEY should be a strong random string in production
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
