# CyberShield Agent Configuration
# Copy to .env and fill in your values

# Backend URL (no trailing slash)
BACKEND_URL=https://cybershield-ai-xnn7.onrender.com
# For local development:
# BACKEND_URL=http://localhost:8000

# Enrollment token — get from the CyberShield dashboard
# Only needed on first run (before agent_identity.json is created)
ENROLLMENT_TOKEN=paste-token-here

# Agent name (shown in the dashboard)
AGENT_NAME=my-laptop

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL=30

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
